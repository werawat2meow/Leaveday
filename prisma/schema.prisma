generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * ---- Enums ----
 */
enum Role {
  MASTER_ADMIN
  ADMIN
  MANAGER
  USER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveKind {
  ANNUAL          // Annual Leave
  SICK            // Sick Leave
  BUSINESS        // Personal/Business Leave
  UNPAID          // Leave without pay
  BIRTHDAY        // Birthday Leave
  ORDAIN          // Monkhood/Ordain
  MATERNITY       // Maternity Leave
  ANNUAL_HOLIDAY  // Annual Holiday Leave (ลาโดยใช้วันหยุดประจำปี)
  SHIFT_CHANGE    // Shift Change (ไม่ตัดสิทธิ์)
  HOLIDAY_CHANGE  // Holiday Change (ไม่ตัดสิทธิ์)
  OT              // OT (ไม่ตัดสิทธิ์)
}

enum LeaveSession {
  FULL   // เต็มวัน
  AM     // ครึ่งเช้า
  PM     // ครึ่งบ่าย
}

/**
 * ---- Models ----
 */
model User {
  id           Int     @id @default(autoincrement())
  name         String?
  email        String  @unique
  passwordHash String
  role         Role    @default(USER)

  leaves    Leave[] // คำขอที่ user นี้ยื่น
  employee  Employee?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

model Leave {
  id Int @id @default(autoincrement())

  // ผู้ยื่นคำขอ
  user   User @relation(fields: [userId], references: [id])
  userId Int

  // ผู้อนุมัติ (อาจยังว่าง)
  approver   Approver? @relation(fields: [approverId], references: [id])
  approverId Int?

  // 🔁 เปลี่ยนจาก type:String → kind:LeaveKind
  kind       LeaveKind
  startDate  DateTime
  endDate    DateTime

  // ✅ เพิ่มฟิลด์ให้ครบตามฟอร์ม
  session       LeaveSession?
  reason        String?
  approverReason    String?  // เหตุผลจากผู้อนุมัติ
  approverSignature String?  // ลายเซ็นของผู้อนุมัติ (Base64 หรือ URL)
  contact       String?
  handoverTo    String?
  attachmentUrl String?

  // ✅ เก็บจำนวน "วันทำการที่นับแล้ว" (รองรับ .5)
  requestedDays Decimal @default(0.0) @db.Decimal(5,2)

  status     LeaveStatus @default(PENDING)
  approvedAt DateTime?

    // HR Confirmation (ยืนยันจาก HR หลัง manager อนุมัติ)
  hrConfirmed   Boolean   @default(false)
  hrConfirmedAt DateTime?
  hrConfirmedBy String?   // email ของ HR ที่ยืนยัน

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([approverId])
  @@index([status, createdAt])
  @@index([kind, startDate, endDate]) // ช่วย query รายปี/ตามประเภท
  @@index([hrConfirmed])
}
model Employee {
  id             Int       @id @default(autoincrement())
  empNo          String    @unique
  email          String?   @unique
  prefix         String?
  firstName      String
  lastName       String
  idCard         String?   @unique
  org            String? // สังกัด
  department     String? // แผนก
  division       String? // ฝ่าย
  unit           String? // หน่วย
  position       String? // ตำแหน่ง
  levelP         String?
  lineId         String?
  startDate      DateTime?
  weeklyHoliday  String? // วันหยุดประจำสัปดาห์ (เช่น "อาทิตย์")

  photoUrl String?

  // ผูกกับ user (ถ้าต้องการ)
  userId Int?  @unique
  user   User? @relation(fields: [userId], references: [id])
  leaveRights LeaveRights[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empNo])
}


model Holiday {
  id         Int       @id @default(autoincrement())
  title      String    // ชื่อวันหยุด
  date       DateTime  // วันที่ (ใช้ only date)
  note       String?   // หมายเหตุ

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([date, title])           // กันซ้ำ (ถ้าต้องการ)
  @@index([date])
}


model Approver {
  id          Int      @id @default(autoincrement())
  prefix      String?
  firstNameTh String
  lastNameTh  String
  firstNameEn String?
  lastNameEn  String?
  empNo       String   @unique
  citizenId   String?  @unique
  org         String?
  department  String?
  division    String?
  unit        String?
  level       String?
  lineId      String?
  email       String?  @unique   // ✅ เพิ่มเพื่อผูกกับตาราง User

  // ✅ เพิ่ม relation สำหรับ Leave records ที่อนุมัติ
  approvedLeaves Leave[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LeaveRights {
  id                        Int      @id @default(autoincrement())
  employeeId                Int
  year                      Int
    annualLeave               Int
    carryForwardAnnual        Int      @default(0)
    carryForwardAnnualExpiry  DateTime?
    holidayLeave              Int
    carryForwardHoliday       Int      @default(0)
    carryForwardHolidayExpiry DateTime?
    vacationLeave             Int      @default(0)
    businessLeave             Int      @default(0)
    sickLeave                 Int      @default(0)
    ordainLeave               Int      @default(0)
    maternityLeave            Int      @default(0)
    unpaidLeave               Int      @default(0)
    birthdayLeave             Int      @default(0)
  employee                  Employee @relation(fields: [employeeId], references: [id])
}

model LeaveRightsTemplate {
  id                  Int    @id @default(autoincrement())
  prefix              String
    maternityLeaveDays  Int
    ordainLeaveDays     Int
    annualLeaveDays     Int
    holidayLeaveDays    Int
    vacationLeaveDays   Int
    businessLeaveDays   Int
    sickLeaveDays       Int
    unpaidLeaveDays     Int
    birthdayLeaveDays   Int
}

