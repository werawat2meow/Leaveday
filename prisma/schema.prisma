generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
}

// ---- Enums ----
enum Role {
  MASTER_ADMIN
  ADMIN
  MANAGER
  USER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveKind {
  ANNUAL          // Annual Leave
  SICK            // Sick Leave
  BUSINESS        // Personal/Business Leave
  UNPAID          // Leave without pay
  BIRTHDAY        // Birthday Leave
  ORDAIN          // Monkhood/Ordain
  MATERNITY       // Maternity Leave
  ANNUAL_HOLIDAY  // Annual Holiday Leave (ลาโดยใช้วันหยุดประจำปี)
  SHIFT_CHANGE    // Shift Change (ไม่ตัดสิทธิ์)
  HOLIDAY_CHANGE  // Holiday Change (ไม่ตัดสิทธิ์)
  OT              // OT (ไม่ตัดสิทธิ์)
}

enum LeaveSession {
  FULL   // เต็มวัน
  AM     // ครึ่งเช้า
  PM     // ครึ่งบ่าย
}

// ---- Models ----
model User {
  id           Int     @id @default(autoincrement())
  name         String?
  email        String  @unique
  passwordHash String
  role         Role    @default(USER)

  leaves    Leave[] // คำขอที่ user นี้ยื่น
  employee  Employee?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

model Leave {
  id Int @id @default(autoincrement())

  // ผู้ยื่นคำขอ
  user   User @relation(fields: [userId], references: [id])
  userId Int

  // ผู้อนุมัติ (อาจยังว่าง)
  approver   Approver? @relation(fields: [approverId], references: [id])
  approverId Int?

  // 🔁 เปลี่ยนจาก type:String → kind:LeaveKind
  kind       LeaveKind
  startDate  DateTime
  endDate    DateTime

  // ✅ เพิ่มฟิลด์ให้ครบตามฟอร์ม
  session       LeaveSession?
  reason        String?
  approverReason    String?  // เหตุผลจากผู้อนุมัติ
  approverSignature String?  // ลายเซ็นของผู้อนุมัติ (Base64 หรือ URL)
  contact       String?
  handoverTo    String?
  attachmentUrl String?

  // ✅ เก็บจำนวน "วันทำการที่นับแล้ว" (รองรับ .5)
  requestedDays Decimal @default(0.0) @db.Decimal(5,2)

  // เก็บแผนการกันสิทธิ์/หักสิทธิ์ที่คำนวณตอนสร้างคำขอ (แยกตามปี)
  // รูปแบบตัวอย่าง: { "2025": { "cf": 1, "current": 0 } }
  reservation Json?

  status     LeaveStatus @default(PENDING)
  approvedAt DateTime?

    // HR Confirmation (ยืนยันจาก HR หลัง manager อนุมัติ)
  hrConfirmed   Boolean   @default(false)
  hrConfirmedAt DateTime?
  hrConfirmedBy String?   // email ของ HR ที่ยืนยัน

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([approverId])
  @@index([status, createdAt])
  @@index([kind, startDate, endDate]) // ช่วย query รายปี/ตามประเภท
  @@index([hrConfirmed])
}
model Employee {
  id             Int       @id @default(autoincrement())
  empNo          String    @unique
  email          String?   @unique
  prefix         String?
  firstName      String
  lastName       String
  idCard         String?   @unique

  // ฟิลด์ใหม่
  orgId        Int?
  departmentId Int?
  divisionId   Int?
  unitId       Int?

  // ฟิลด์เดิม (ยังคงไว้)
  org            String?
  department     String?
  division       String?
  unit           String?
  position       String?
  levelP         String?
  lineId         String?
  startDate      DateTime?
  weeklyHoliday  String?

  photoUrl String?

  approvers      Approver[] @relation("EmployeeApprovers")

  organization Organization? @relation("OrgToEmployee", fields: [orgId], references: [id])
  departmentRel Department?  @relation("DeptToEmployee", fields: [departmentId], references: [id])
  divisionRel   Division?    @relation("DivToEmployee", fields: [divisionId], references: [id])
  unitRel       Unit?        @relation("UnitToEmployee", fields: [unitId], references: [id])

  userId Int?  @unique
  user   User? @relation(fields: [userId], references: [id])
  leaveRights LeaveRights[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empNo])
}


model Holiday {
  id         Int       @id @default(autoincrement())
  title      String    // ชื่อวันหยุด
  date       DateTime  // วันที่ (ใช้ only date)
  note       String?   // หมายเหตุ

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([date, title])           // กันซ้ำ (ถ้าต้องการ)
  @@index([date])
}


model Approver {
  id          Int      @id @default(autoincrement())
  prefix      String?
  firstNameTh String
  lastNameTh  String
  firstNameEn String?
  lastNameEn  String?
  empNo       String   @unique
  citizenId   String?  @unique

  // ฟิลด์ใหม่
  orgId        Int?
  departmentId Int?
  divisionId   Int?
  unitId       Int?
  // ฟิลด์เดิม (ยังคงไว้)
  org         String?
  department  String?
  division    String?
  unit        String?
  level       String?
  lineId      String?
  email       String?  @unique

  employees      Employee[] @relation("EmployeeApprovers")
  allowCrossOrg Boolean  @default(false)

  organization Organization? @relation("OrgToApprover", fields: [orgId], references: [id])
  departmentRel Department?  @relation("DeptToApprover", fields: [departmentId], references: [id])
  divisionRel   Division?    @relation("DivToApprover", fields: [divisionId], references: [id])
  unitRel       Unit?        @relation("UnitToApprover", fields: [unitId], references: [id])

  approvedLeaves Leave[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LeaveRights {
  id                        Int      @id @default(autoincrement())
  employeeId                Int
  year                      Int
    annualLeave               Int
    carryForwardAnnual        Int      @default(0)
    carryForwardAnnualExpiry  DateTime?
    holidayLeave              Int
    carryForwardHoliday       Int      @default(0)
    carryForwardHolidayExpiry DateTime?
    vacationLeave             Int      @default(0)
    businessLeave             Int      @default(0)
    sickLeave                 Int      @default(0)
    ordainLeave               Int      @default(0)
    maternityLeave            Int      @default(0)
    unpaidLeave               Int      @default(0)
    birthdayLeave             Int      @default(0)
  employee                  Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, year], name: "employeeId_year")
}

model LeaveRightsTemplate {
  id                  Int    @id @default(autoincrement())
  prefix              String
    maternityLeaveDays  Int
    ordainLeaveDays     Int
    annualLeaveDays     Int
    holidayLeaveDays    Int
    vacationLeaveDays   Int
    businessLeaveDays   Int
    sickLeaveDays       Int
    unpaidLeaveDays     Int
    birthdayLeaveDays   Int
}

model Organization {
  id         Int          @id @default(autoincrement())
  name       String
  departments Department[]
  employees   Employee[]   @relation("OrgToEmployee")
  approvers   Approver[]   @relation("OrgToApprover")
}

model Department {
  id             Int          @id @default(autoincrement())
  name           String
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId Int
  divisions      Division[]
  employees      Employee[]   @relation("DeptToEmployee")
  approvers      Approver[]   @relation("DeptToApprover")
}

model Division {
  id           Int        @id @default(autoincrement())
  name         String
  department   Department @relation(fields: [departmentId], references: [id])
  departmentId Int
  units        Unit[]
  employees    Employee[] @relation("DivToEmployee")
  approvers    Approver[] @relation("DivToApprover")
}

model Unit {
  id         Int       @id @default(autoincrement())
  name       String
  division   Division  @relation(fields: [divisionId], references: [id])
  divisionId Int
  employees  Employee[] @relation("UnitToEmployee")
  approvers  Approver[] @relation("UnitToApprover")
}


